# Names only — never commit values. Real values live in .env.local (gitignored),
# Vercel project settings, and GitHub Actions secrets (dev only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Used only in src/lib/supabase/admin.ts
SUPABASE_SECRET_KEY=
# ── Reminder email (feature 06). Server-only; never NEXT_PUBLIC_. ──
# MAIL_TRANSPORT unset = "test": never sends (CI, local, previews). Staging/prod set "brevo" on purpose.
MAIL_TRANSPORT=
# Read only in src/lib/mail/brevo.ts (ESLint fence). One Brevo account per environment.
BREVO_API_KEY=
# The firm's Brevo sender (per environment); Reply-To is always the staff member who sends.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
# "production" only in prod. Anywhere else, only EMAIL_ALLOWLIST addresses receive mail; ".test" never does.
APP_ENV=
EMAIL_ALLOWLIST=
# Office emails per day (sent + in flight); default 200.
EMAIL_DAILY_MAX=

# Feature 10 — client upload links (server-only)
# Base URL put in upload links, per environment, https (e.g. https://vault.example.in). Local: http://localhost:3000
APP_PUBLIC_URL=
# Secret salt for hashing client IPs in the link rate limiter (≥ 16 characters; required when APP_ENV=production)
LINK_IP_SALT=
# 10 step 11: bearer secret Vercel Cron sends to /api/cron/storage-sweep (≥ 16 chars; unset = the route refuses).
CRON_SECRET=
# 14: DSC token PIN / password encryption (AES-256-GCM, src/lib/dsc/crypto.ts only). "<id>:<base64 of 32 bytes>", comma-
# separated; keep old ids listed after a rotation. Per environment, server-only; back the key up outside Vercel (losing it
# makes every stored password unreadable). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Local test runs may use the public test key (refused in production): DSC_ENC_KEYS=test:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
DSC_ENC_KEYS=
DSC_KEY_ID=
