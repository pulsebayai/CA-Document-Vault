{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/production-gate.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*[Ss]upabase.*__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/supabase-gate.sh"
          }
        ]
      }
    ]
  }
}
